import sys
import random


from PyQt6.QtWidgets import QApplication, QMainWindow, QWidget, QPushButton, QLabel, QLineEdit, QVBoxLayout, QGridLayout
from PyQt6.QtCore import QTimer, Qt




from PyQt6.QtCore import QTimer, Qt




class WhackAMole(QMainWindow):


    def __init__(self):
        super().__init__()


        self.setWindowTitle("Whack-a-Mole")
        self.setFixedSize(550, 650)


        # Basic game variables
        self.score = 0
        self.game_duration = 0
        self.time_passed = 0
        self.mole_position = -1
        self.game_running = False


        # Timer for the game
        self.timer = QTimer()
        self.timer.timeout.connect(self.update_timer)


        # Main layout
        central_widget = QWidget()
        self.setCentralWidget(central_widget)


        self.main_layout = QVBoxLayout()
        central_widget.setLayout(self.main_layout)


        # Title
        self.title_label = QLabel(
            "Whack-a-Mole!"
        )


        self.title_label.setAlignment(
            Qt.AlignmentFlag.AlignCenter
        )


        self.title_label.setStyleSheet("""
            QLabel {
                font-size: 28px;
                font-weight: bold;
            }
        """)


        self.main_layout.addWidget(
            self.title_label
        )


        # Instructions
        self.instruction_label = QLabel(
            "Enter how many seconds you want to play for (15 - 60)"
        )


        self.instruction_label.setAlignment(
            Qt.AlignmentFlag.AlignCenter
        )


        self.main_layout.addWidget(
            self.instruction_label
        )


        # Duration input
        self.duration_input = QLineEdit()


        self.duration_input.setPlaceholderText(
            "Enter duration"
        )


        self.duration_input.setFixedHeight(
            40
        )


        self.main_layout.addWidget(
            self.duration_input
        )


        # Start button
        self.start_button = QPushButton(
            "Start!"
        )


        self.start_button.setFixedHeight(
            45
        )


        self.start_button.clicked.connect(
            self.start_game
        )


        self.main_layout.addWidget(
            self.start_button
        )


        # Used for messages
        self.message_label = QLabel(
            "Press Start to begin"
        )


        self.message_label.setAlignment(
            Qt.AlignmentFlag.AlignCenter
        )


        self.main_layout.addWidget(
            self.message_label
        )


        # Make the 4x4 board
        self.grid_layout = QGridLayout()


        self.grid_layout.setSpacing(5)


        self.buttons = []


        for row in range(4):


            for column in range(4):


                button = QPushButton("")


                button.setFixedSize(
                    120,
                    100
                )


                button.setStyleSheet("""
                    QPushButton {
                        background-color: white;
                        color: black;
                        border: 2px solid black;
                        font-size: 16px;
                    }


                    QPushButton:hover {
                        background-color: lightgrey;
                    }
                """)


                button_number = (
                    row * 4 + column
                )


                button.clicked.connect(
                    lambda checked,
                    number=button_number:
                    self.button_clicked(number)
                )


                self.grid_layout.addWidget(
                    button,
                    row,
                    column
                )


                self.buttons.append(
                    button
                )


        self.main_layout.addLayout(
            self.grid_layout
        )




    # Starts the game
    def start_game(self):


        duration_text = (
            self.duration_input.text()
        )


        # Basic validation
        if duration_text.isdigit() == False:


            self.message_label.setText(
                "Please enter a whole number, James"
            )


            return


        duration = int(
            duration_text
        )


        if duration < 15 or duration > 60:


            self.message_label.setText(
                "Please choose between 15 and 60 seconds"
            )


            return


        self.game_duration = duration
        self.time_passed = 0
        self.score = 0


        self.game_running = True


        self.clear_grid()


        self.message_label.setText(
            "Game started!"
        )


        self.move_mole()


        self.timer.start(
            1000
        )


    # Checks what square was clicked
    def button_clicked(
        self,
        button_number
    ):


        if self.game_running == False:
            return


        if button_number == self.mole_position:


            self.score += 1


            self.move_mole()


    # Moves mole to a random square
    def move_mole(self):


        old_position = (
            self.mole_position
        )


        possible_positions = []


        for position in range(16):


            if position != old_position:


                possible_positions.append(
                    position
                )


        new_position = random.choice(
            possible_positions
        )


        if old_position != -1:


            self.buttons[
                old_position
            ].setText("")


        self.mole_position = (
            new_position
        )


        self.buttons[
            self.mole_position
        ].setText(
            "Mole"
        )


    # Updates the game timer
    def update_timer(self):


        self.time_passed += 1


        if (
            self.time_passed
            >=
            self.game_duration
        ):


            self.end_game()


    # Ends the game
    def end_game(self):


        self.timer.stop()


        self.game_running = False


        self.clear_grid()


        self.message_label.setText(
            "Game Over! Score: "
            + str(self.score)
        )


        self.save_score()




    # Clears everything from the board
    def clear_grid(self):


        for button in self.buttons:


            button.setText("")


        self.mole_position = -1


    # Saves score to score.txt
    def save_score(self):


        score_file = open(
            "score.txt",
            "a"
        )


        score_file.write(
            str(self.score) + "\n"
        )


        score_file.close()


app = QApplication(
    sys.argv
)


window = WhackAMole()


window.show()


app.exec()
